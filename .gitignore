# --- IDEs and Editors ---
# IntelliJ, WebStorm, etc.
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# Local history and crash dumps
.history/

# --- System Files ---
# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# --- Dependencies ---
# Third-party packages
node_modules/
jspm_packages/
.pnpm-store/

# --- Build and Output ---
# Vite production build output
dist/
dist-ssr/

# TypeScript build info cache
*.tsbuildinfo

# --- Testing and Coverage ---
# Coverage reports
coverage/
*.lcov

# Playwright/Cypress end-to-end testing artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Environment Variables ---
# Local environment files (contains secrets, NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing the template/example file if you use one
!.env.example

# --- Logs ---
# Diagnostic and error logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*